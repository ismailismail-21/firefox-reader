{
  "manifest_version": 3,
  "name": "Firefox Reader",
  "version": "1.0",
  "description": "Extract, clean, and download web pages or send them to a database",
  "permissions": ["scripting", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Firefox Reader"
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/readability.js", "content/content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
